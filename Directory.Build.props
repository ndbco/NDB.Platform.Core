<Project>

  <!--
    Centralized build properties untuk semua project di repo NDB.Platform.Core.
    Setiap csproj akan inherit property di sini, jadi tidak perlu duplicate.
  -->

  <PropertyGroup Label="Target Framework">
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Build Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- CS1591: missing XML doc — silenced di internal/test, exposed di public via Roslyn rule -->
  </PropertyGroup>

  <PropertyGroup Label="Package Metadata">
    <Authors>PT. Navigate Digital Boundaries</Authors>
    <Company>PT. Navigate Digital Boundaries</Company>
    <Product>NDB Platform</Product>
    <Copyright>Copyright © PT. Navigate Digital Boundaries $([System.DateTime]::Now.Year)</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ndbco/NDB.Platform.Core</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ndbco/NDB.Platform.Core</RepositoryUrl>
    <PackageTags>ndb;platform;cqrs;mediator;mapster;result;abstraction;clean-architecture;efcore;dependency-injection</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="SourceLink">
    <!-- Debug experience — link compiled assembly ke commit source di GitHub -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Output">
    <IsPackable>false</IsPackable>
    <!-- Override jadi true di csproj library yang akan di-publish ke NuGet -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Label="SourceLink Reference" Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>